# Vercel supplies OIDC automatically. Outside Vercel, set the explicit credentials.
AI_GATEWAY_API_KEY=
TEX64_AI_MODEL=openai/gpt-5.6-sol
TEX64_SESSION_SECRET=

# Production persistence. Local development uses .data when this is omitted.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Production compiler. Vercel Sandbox uses deployment OIDC automatically.
TEX64_COMPILER=auto
TEX64_SANDBOX_IMAGE=
TEX64_LUALATEX_PATH=

# Anonymous production is opt-in and always protected by shared hourly quotas.
TEX64_ALLOW_ANONYMOUS_PRODUCTION=
TEX64_IDENTITY_RUNS_PER_HOUR=20
TEX64_NETWORK_RUNS_PER_HOUR=40
TEX64_GLOBAL_RUNS_PER_HOUR=

# Required only outside Vercel. The named header must be overwritten by a trusted proxy.
TEX64_TRUSTED_CLIENT_IP_HEADER=
